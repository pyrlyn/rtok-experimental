(( $+functions[_rtok_commands] )) ||
_rtok_commands() {
    local commands; commands=(
'hook:Claude Code hook entry point/: reads the event JSON on stdin, writes JSON to stdout' /
'mcp:Serve MCP tools over stdio; /`-- <server argv>/` wraps a foreign server instead' /
'proxy:Local API proxy for ANTHROPIC_BASE_URL' /
'web:Local web UI over the same data as /`rtok tui/` (WebSocket API + React SPA)' /
'tui:Terminal UI over the same data as /`rtok web/` (one model, two renderings)' /
'stats:Measurements from session logs and the proxy' /
'bench:A/B benchmark of host configurations' /
'doctor:Inspect hooks, MCP servers and the proxy chain' /
'worktree:Git worktrees of this repository/: owner, state and disk cost' /
'task:This project'/''s tasks/: numbered by rtok, stored by the /`/[tasks/]/` adapter' /
'batch:Provider Batch jobs (Anthropic, OpenAI) sent through /`rtok proxy/`' /
'info:Version, effective paths, disk usage, error count and proxy status' /
'agents:Agent hosts (/`rtok agents install|uninstall|list|info …/`)' /
'agent:Agent hosts (/`rtok agents install|uninstall|list|info …/`)' /
'setup:Deprecated spelling of /`rtok agents install <host>/`; still runs, still prints where to go' /
'run:Execute a command, archive its raw output, print the filtered version' /
'filter:Filter text from stdin without executing' /
'expand:Print an archived payload' /
'archive:The archive live zone (/`rtok archive rewrite/` — pi /`context/` carrier)' /
'completions:Print, install or pick shell completions (bash, zsh, fish, powershell, elvish; clink for Windows cmd)' /
'man:Print the man page (roff), or write every page with /`--dir/`' /
'plugins:List plugins/: id, enabled, surfaces' /
'config:The one config file' /
'memory:Notes (/`mem_save/` / import / export)' /
'docs:Cached rustdoc for Cargo.lock dependencies (/`rtok docs fetch/`)' /
'graph:Symbol index (/`rtok graph index/`)' /
'guard:Duplicate-call verdict (/`rtok guard check/` — pi / OpenCode plugin path)' /
'dashboard:Deprecated spelling of /`rtok web/`; still runs, still prints where to go' /
'demon:Keep /`rtok proxy/` (or /`mcp/` / /`web/`) running in the background' /
'otel:OpenTelemetry export (/`rtok otel flush | status/`)' /
'logs:rtok'/''s own log (/`rtok logs/` prints, /`rtok logs export/` strips numbering and colour)' /
'report:The operator model as one document/: Markdown, HTML and PDF' /
'help:Print this message or the help of the given subcommand(s)' /
    )
    _describe -t commands 'rtok commands' commands "$@"
}
(( $+functions[_rtok__subcmd__agents_commands] )) ||
_rtok__subcmd__agents_commands() {
    local commands; commands=(
'install:Install hooks, MCP server and proxy into a host' /
'uninstall:Take rtok back out of a host/: hooks, MCP entry, proxy variable, plugin link' /
'remove:Take rtok back out of a host/: hooks, MCP entry, proxy variable, plugin link' /
'update:Bring what rtok installed up to date/: in place where it can, reinstalled where not' /
'outdated:List hosts whose rtok plugin is older than this binary' /
'list:Every known app/: kind and name, path and version, config files, rtok modules' /
'info:One host/: the same block /`agents list/` prints, just for that app' /
'sessions:What is running in this project/: host, provider, model, tokens, start, run time' /
'usage:Tokens and estimated cost per agent and month (or day), from the agents'/'' logs or rtok' /
'junk:Junk and agent folders/: /`list/` shows rtok'/''s and every installed host'/''s folders with sizes, /`clear/` removes rtok'/''s own junk or, filtered, any agent'/''s' /
'whoami:This session'/''s own rtok agent id/: /`RTOK_AGENT_ID/`, resolved through the store' /
'show:One agent by id prefix/: host, model, ids, parent and sub-agents, cwd, activity, status' /
'status:Say what this agent (/`RTOK_AGENT_ID/`) is busy with/: plain text, at most 120 chars' /
'send:Send a message to an agent/: /`send <id-prefix> <text|->/` or /`send --all-live <text|->/`' /
'inbox:Read messages/: your own inbox from /`RTOK_AGENT_ID/` (marks them read), or with an id that agent'/''s queue (marks nothing)' /
'help:Print this message or the help of the given subcommand(s)' /
    )
    _describe -t commands 'rtok agents commands' commands "$@"
}
(( $+functions[_rtok__subcmd__agents__subcmd__help_commands] )) ||
_rtok__subcmd__agents__subcmd__help_commands() {
    local commands; commands=(
'install:Install hooks, MCP server and proxy into a host' /
'uninstall:Take rtok back out of a host/: hooks, MCP entry, proxy variable, plugin link' /
'update:Bring what rtok installed up to date/: in place where it can, reinstalled where not' /
