(( $+functions[_rtok__subcmd__task_commands] )) ||
_rtok__subcmd__task_commands() {
    local commands; commands=(
'create:Create a task under the next free id and print the id' /
'list:The plan/: open and in-progress tasks, subtasks under their parent' /
'show:One task/: title, status, parent, subtasks, link and description' /
'status:Print a task'/''s status, or set it; done and closed move it out of the plan' /
'next:The first ready task/: free or stale, not blocked; a leaf when nothing is blocked' /
'ready:Tasks that can be claimed, highest priority first' /
'claim:Claim a task for this agent, or the first ready task when no id is given. On GitHub and GitLab the assignee write is last-write-wins, not compare-and-set' /
'release:Clear the assignee and set the task open. Only the holder, unless --force' /
'dep:Record that this task waits on another. A cycle is refused and nothing is written' /
'priority:Set priority from 0 (highest) to 4. 2 is the default and is not stored' /
'conflict:Record that two tasks touch the same files, so they should not run at once. Symmetric; /`ready/` flags a task whose partner is in progress' /
'parallel:Mark a task safe to run beside any other task' /
'sync:Raise the id counters to the adapter'/''s highest ids and report drift; never writes the adapter' /
'export:Mirror the disk tasks one way into an issue tracker; the files stay the source of truth. A second run with nothing changed sends no write' /
'init:Write /`/[tasks/]/` into this checkout'/''s /`.rtok.toml/` and seed the counter from existing tasks' /
'help:Print this message or the help of the given subcommand(s)' /
    )
    _describe -t commands 'rtok task commands' commands "$@"
}
