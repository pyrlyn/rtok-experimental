            [CompletionResult]::new('diff', 'diff', [CompletionResultType]::ParameterValue, 'What a change did to the graph: symbols changed, added, removed, renamed or moved, with callers')
            [CompletionResult]::new('export', 'export', [CompletionResultType]::ParameterValue, 'The graph as `rtok.graph.v1` JSON, with home, user name and absolute paths redacted')
            [CompletionResult]::new('affected', 'affected', [CompletionResultType]::ParameterValue, 'Tests that reach files changed in git (`git diff --name-only`)')
            break
        }
        'rtok;help;graph;index' {
            break
        }
        'rtok;help;graph;dead' {
            break
        }
        'rtok;help;graph;status' {
            break
        }
        'rtok;help;graph;impact' {
            break
        }
        'rtok;help;graph;projects' {
            [CompletionResult]::new('add', 'add', [CompletionResultType]::ParameterValue, 'Register a directory as a project (a known one only refreshes its last-used time)')
            [CompletionResult]::new('select', 'select', [CompletionResultType]::ParameterValue, 'Make a project the selected one; the page and later the CLI answer for it')
            [CompletionResult]::new('link', 'link', [CompletionResultType]::ParameterValue, 'Link a project into the selected one''s graph scope (indexes it when it never was)')
            [CompletionResult]::new('unlink', 'unlink', [CompletionResultType]::ParameterValue, 'Remove a link; an auto link stays removed on re-index')
            [CompletionResult]::new('remove', 'remove', [CompletionResultType]::ParameterValue, 'Drop a project and its index rows; its files are never touched')
            break
        }
        'rtok;help;graph;projects;add' {
            break
        }
        'rtok;help;graph;projects;select' {
            break
        }
        'rtok;help;graph;projects;link' {
            break
        }
        'rtok;help;graph;projects;unlink' {
            break
        }
        'rtok;help;graph;projects;remove' {
            break
        }
        'rtok;help;graph;review' {
            break
        }
        'rtok;help;graph;diff' {
            break
        }
        'rtok;help;graph;export' {
            break
        }
        'rtok;help;graph;affected' {
            break
        }
        'rtok;help;guard' {
            [CompletionResult]::new('check', 'check', [CompletionResultType]::ParameterValue, 'Print `{"allow":true}` or `{"allow":false,"reason":…}` (fail open: bad input allows)')
            break
        }
        'rtok;help;guard;check' {
            break
        }
        'rtok;help;dashboard' {
            break
        }
        'rtok;help;demon' {
            [CompletionResult]::new('start', 'start', [CompletionResultType]::ParameterValue, 'Detach a supervisor that restarts the service whenever it dies')
            [CompletionResult]::new('stop', 'stop', [CompletionResultType]::ParameterValue, 'Ask the supervisor and its child to exit')
            [CompletionResult]::new('restart', 'restart', [CompletionResultType]::ParameterValue, 'Stop, then start')
            [CompletionResult]::new('upgrade', 'upgrade', [CompletionResultType]::ParameterValue, 'Stop live surfaces, replace the binary, start the same set')
            [CompletionResult]::new('status', 'status', [CompletionResultType]::ParameterValue, 'State, pids, uptime, restarts and log path; every service when none is named')
            [CompletionResult]::new('kill', 'kill', [CompletionResultType]::ParameterValue, 'SIGKILL instead of SIGTERM, and drop the state file')
            [CompletionResult]::new('supervise', 'supervise', [CompletionResultType]::ParameterValue, 'The detached half; `demon start` runs this, you do not')
            break
        }
        'rtok;help;demon;start' {
            break
        }
        'rtok;help;demon;stop' {
            break
        }
        'rtok;help;demon;restart' {
            break
        }
        'rtok;help;demon;upgrade' {
            break
        }
        'rtok;help;demon;status' {
            break
        }
        'rtok;help;demon;kill' {
            break
        }
        'rtok;help;demon;supervise' {
            break
        }
        'rtok;help;otel' {
            [CompletionResult]::new('flush', 'flush', [CompletionResultType]::ParameterValue, 'Post rows past the watermarks to the endpoint, once')
            [CompletionResult]::new('status', 'status', [CompletionResultType]::ParameterValue, 'Endpoint, watermarks, pending rows, last exporter log line')
            break
        }
        'rtok;help;otel;flush' {
            break
        }
        'rtok;help;otel;status' {
            break
        }
        'rtok;help;logs' {
            [CompletionResult]::new('export', 'export', [CompletionResultType]::ParameterValue, 'Same selection, no numbering, no colour — for `rtok logs export > my.log`')
            [CompletionResult]::new('watch', 'watch', [CompletionResultType]::ParameterValue, 'Print the last lines, then follow: new lines arrive above the old, newest first')
            break
        }
        'rtok;help;logs;export' {
            break
        }
        'rtok;help;logs;watch' {
            break
        }
        'rtok;help;report' {
            break
        }
        'rtok;help;help' {
            break
        }
    })

    $completions.Where{ $_.CompletionText -like "$wordToComplete*" } |
        Sort-Object -Property ListItemText
}
